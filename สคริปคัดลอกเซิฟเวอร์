-- Refresh UI list
local function refreshSavedList()
    savedList:ClearAllChildren()
    local y = 0
    for index, saved in ipairs(_G.SavedJobIds) do
        local item = Instance.new("Frame", savedList)
        item.Size = UDim2.new(1, 0, 0, 28)
        item.Position = UDim2.new(0, 0, 0, y)
        item.BackgroundTransparency = 1

        local label = Instance.new("TextLabel", item)
        label.Text = saved.label
        label.Size = UDim2.new(0.4, 0, 1, 0)
        label.BackgroundTransparency = 1
        label.TextColor3 = Color3.fromRGB(30, 30, 30)
        label.Font = Enum.Font.Gotham
        label.TextSize = 12
        label.TextXAlignment = Enum.TextXAlignment.Left

        local copy = Instance.new("TextButton", item)
        copy.Text = "คัดลอก"
        copy.Size = UDim2.new(0, 45, 0, 24)
        copy.Position = UDim2.new(0.45, 0, 0, 2)
        copy.BackgroundColor3 = Color3.fromRGB(200, 200, 255)
        copy.TextSize = 12
        Instance.new("UICorner", copy).CornerRadius = UDim.new(0, 4)
        copy.MouseButton1Click:Connect(function()
            if setclipboard then setclipboard(saved.jobId) end
        end)

        local join = Instance.new("TextButton", item)
        join.Text = "เข้า"
        join.Size = UDim2.new(0, 45, 0, 24)
        join.Position = UDim2.new(0.63, 0, 0, 2)
        join.BackgroundColor3 = Color3.fromRGB(180, 255, 180)
        join.TextSize = 12
        Instance.new("UICorner", join).CornerRadius = UDim.new(0, 4)
        join.MouseButton1Click:Connect(function()
            TeleportService:TeleportToPlaceInstance(game.PlaceId, saved.jobId, player)
        end)

        local del = Instance.new("TextButton", item)
        del.Text = "ลบ"
        del.Size = UDim2.new(0, 26, 0, 24)
        del.Position = UDim2.new(1, -28, 0, 2)
        del.BackgroundColor3 = Color3.fromRGB(255, 100, 100)
        del.TextColor3 = Color3.fromRGB(255, 255, 255)
        del.TextSize = 12
        Instance.new("UICorner", del).CornerRadius = UDim.new(0, 4)
        del.MouseButton1Click:Connect(function()
            table.remove(_G.SavedJobIds, index)
            saveToFile()
            refreshSavedList()
        end)

        y += 30
    end
    savedList.CanvasSize = UDim2.new(0, 0, 0, y)
end

