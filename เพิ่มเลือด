-- ================= การทำงาน =================

-- กดครั้งเดียว (10 ครั้ง)
OnceBtn.MouseButton1Click:Connect(function()
    for i = 1, 10 do
        task.spawn(function()
            Remote():FireServer(player)
        end)
    end
end)

-- เปิด/ปิดรัว
local running = false

ToggleRunBtn.MouseButton1Click:Connect(function()
    running = not running
    ToggleRunBtn.Text = running and "เปิด" or "ปิด"
    ToggleRunBtn.BackgroundColor3 = running
        and Color3.fromRGB(70,180,70)
        or Color3.fromRGB(180,70,70)

    if running then
        task.spawn(function()
            while running do
                for i = 1, 30 do
                    task.spawn(function()
                        Remote():FireServer(player)
                    end)
                end
                task.wait(0.05)
            end
        end)
    end
end)

-- ปุ่มซ่อน/โชว์ GUI
GuiToggleBtn.MouseButton1Click:Connect(function()
    Frame.Visible = not Frame.Visible
end)
