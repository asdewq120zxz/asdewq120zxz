-- 🔍 หาเป้าหมายที่ใกล้ที่สุด
local function GetClosestTarget()
    if not Character or not HumanoidRootPart then return nil end
    
    local hrp = HumanoidRootPart
    if not hrp then return nil end

    local closest, shortest = nil, LOCK_RANGE
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and obj ~= Character then
            local hum = obj:FindFirstChildOfClass("Humanoid")
            local tHrp = obj:FindFirstChild("HumanoidRootPart")

            if hum and hum.Health > 0 and tHrp then
                local dist = (hrp.Position - tHrp.Position).Magnitude
                if dist < shortest then
                    shortest = dist
                    closest = tHrp
                end
            end
        end
    end
    return closest, shortest
end

-- ฟังก์ชันใช้ Dash
local function UseDash()
    local args = {
        [1] = {
            ["Dash"] = Enum.KeyCode.A,
            ["Key"] = Enum.KeyCode.Q,
            ["Goal"] = "KeyPress"
        }
    }
    if Character and Character:FindFirstChild("Communicate") then
        Character.Communicate:FireServer(unpack(args))
    end
end

-- ⭐ ระบบ Dash + หมุนรอบศัตรู
local function PerformLoopDash()  
    if not Character or not HumanoidRootPart then
        updateCharacter()
        if not Character then return end
    end
    
    local humanoid = Character:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 then return end

    local startHealth = humanoid.Health

    local target, dist = GetClosestTarget()
    if not target then 
        warn("ไม่พบเป้าหมายในระยะ")
        return 
    end

    local pos = HumanoidRootPart.Position
    local dir = (target.Position - pos).Unit
    local endPos = target.Position - dir * TARGET_DISTANCE

    local doDash = dist > SPIN_IMMEDIATE_DISTANCE

    -- ใช้ Dash เมื่อต้องพุ่ง
    if doDash then
        UseDash()
        task.wait(0.05)
    end

    -- เล่นอนิเมชั่น
    if humanoid then
        local anim = Instance.new("Animation")
        anim.AnimationId = "rbxassetid://" .. ANIMATION_ID
        CurrentAnimation = humanoid:LoadAnimation(anim)
        CurrentAnimation:Play()
    end

    -- ใช้ Dash เมื่อหมุนทันทีด้วย (เพิ่มส่วนนี้)
    if not doDash then
        UseDash()
        task.wait(0.05)
    end

    local dashSpeedMultiplier = 1.5
    local travelTime = (pos - endPos).Magnitude / (SPIN_SPEED * 10 * dashSpeedMultiplier)
    local startTime = tick()
    local currentSpin = 0
    local totalSpin = 370

    local conn
    conn = RunService.Heartbeat:Connect(function(dt)
        if not Character or not HumanoidRootPart or not humanoid or humanoid.Health <= 0 then
            if conn then conn:Disconnect() end
            return
        end

        if not target or not target.Parent then
            if conn then conn:Disconnect() end
            return
        end

        if humanoid.Health < startHealth then
            if conn then conn:Disconnect() end
            return
        end

        if doDash then
            local t = math.min((tick() - startTime) / travelTime, 1)
            local easedT = t < 0.5 and 2 * t * t or 1 - math.pow(-2 * t + 2, 2) / 2
            local p = pos + (endPos - pos) * easedT
            HumanoidRootPart.CFrame = CFrame.new(p, target.Position)
            
            if t >= 0.8 then
                doDash = false
            end
        end

        if (doDash and tick() - startTime >= travelTime * 0.2) or not doDash then
            currentSpin = currentSpin + dt * (totalSpin * SPIN_SPEED * 1.2)
            local angle = math.rad(currentSpin)

            local orbitX = target.Position.X + TARGET_DISTANCE * math.cos(angle)
            local orbitZ = target.Position.Z + TARGET_DISTANCE * math.sin(angle)
            local orbitPos = Vector3.new(orbitX, target.Position.Y, orbitZ)

            HumanoidRootPart.CFrame = CFrame.new(orbitPos, target.Position)
        end

        if currentSpin >= totalSpin then
            if HumanoidRootPart then
                HumanoidRootPart.CFrame = CFrame.new(HumanoidRootPart.Position, target.Position)
            end
            if conn then conn:Disconnect() end
            if CurrentAnimation then
                CurrentAnimation:Stop()
                CurrentAnimation = nil
            end
        end
    end)
end

